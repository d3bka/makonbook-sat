# MakonBook local/development environment
# Copy to .env and fill secret values. Never commit .env.

# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SITE_DOMAIN=localhost:8000
SITE_PROTOCOL=http
SITE_ID=1

# Database
# For local SQLite, set DB_ENGINE=django.db.backends.sqlite3 and leave the
# PostgreSQL values unused. The project also supports DATABASE_URL.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=makonbook
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=disable
DB_CONN_MAX_AGE=0
DATABASE_URL=

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=makonbook
R2_ENDPOINT_URL=
R2_REGION=auto
# AWS_S3_CUSTOM_DOMAIN=

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MakonBook Support <support@makonbook.uz>
SERVER_EMAIL=MakonBook Support <support@makonbook.uz>

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Telegram bot
TELEGRAM_BOT_TOKEN=

# Redis / Celery
# When running Django/Celery directly on Windows use 127.0.0.1.
# Docker Compose overrides these to redis://redis:6379/... by default.
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_RESULT_EXPIRES=86400
REGISTRATION_RATE_LIMIT_CACHE_URL=redis://127.0.0.1:6379/3

# Registration rate limiting
REGISTRATION_RATE_LIMIT_ENABLED=True
REGISTRATION_RATE_LIMIT_IP_MAX=20
REGISTRATION_RATE_LIMIT_IP_WINDOW_SECONDS=600
REGISTRATION_RATE_LIMIT_IDENTIFIER_MAX=5
REGISTRATION_RATE_LIMIT_IDENTIFIER_WINDOW_SECONDS=1800

# Test Import rate limiting
TEST_IMPORT_RATE_LIMIT_ENABLED=True
TEST_IMPORT_SUBMIT_COOLDOWN_SECONDS=15
TEST_IMPORT_RATE_LIMIT_MAX=6
TEST_IMPORT_RATE_LIMIT_WINDOW_SECONDS=600

# AI / question audit
# Structured PDF v2 parsing itself is deterministic; AI audit is optional.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
QUESTION_AUDIT_PROVIDER=deepseek
QUESTION_AUDIT_MODEL=deepseek-v4-flash
QUESTION_AUDIT_TIMEOUT_SECONDS=90
QUESTION_AUDIT_BATCH_SIZE=12
QUESTION_AUDIT_MAX_TOKENS=12000
QUESTION_AUDIT_JSON_RETRIES=2
QUESTION_AUDIT_DEEPSEEK_THINKING=0
QUESTION_AUDIT_DEEPSEEK_REASONING_EFFORT=low

# Legacy / CLI test import compatibility
TEST_IMPORT_MODEL=gpt-5.6-terra
TEST_IMPORT_AUDIT_MODEL=deepseek-v4-flash
TEST_IMPORT_RUN_AI_AUDIT=1
TEST_IMPORT_TIMEOUT_SECONDS=180

# Security cookie/HSTS overrides (normally defaults are enough)
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
